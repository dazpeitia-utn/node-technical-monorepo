# Copy to .env — values match the local docker-compose.yml services.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/flash_sale_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379

# Change in any non-local environment.
JWT_SECRET=super_secret_key_flash_sale
PORT=3000

# Order queue (BullMQ on the same Redis). All optional.
ORDER_QUEUE_NAME=orders
ORDER_WORKER_CONCURRENCY=10
# Artificial delay per order in the worker, to simulate slow integrations in load tests.
ORDER_PROCESSING_DELAY_MS=0
