{
  "name": "flash-sale-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/infrastructure/inbound/http/server.ts",
    "dev:worker": "tsx watch src/infrastructure/inbound/queue/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/infrastructure/inbound/http/server.js",
    "start:worker": "node dist/infrastructure/inbound/queue/worker.js",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/client": "5.19.0",
    "bullmq": "6.7.6",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prisma": "5.19.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^1.2.0"
  }
}
